# Copy this file to .env and fill in your own values.
#
# Create a Deye Cloud account:
# https://www.deyecloud.com/login
#
# Create a developer application to obtain your App ID and App Secret:
# https://developer.deyecloud.com/app

# ------------------------------------------------------------------
# Deye Cloud Configuration
# ------------------------------------------------------------------

# API Region:
#   eu = Europe, Africa, Asia-Pacific
#   us = North & South America
DEYE_REGION=eu

DEYE_APP_ID=your_app_id_here
DEYE_APP_SECRET=your_app_secret_here

# Deye Cloud account credentials
DEYE_EMAIL=your_email@example.com
DEYE_PASSWORD=your_password_here

# Usually 0 unless instructed otherwise by Deye or your installer.
DEYE_COMPANY_ID=0

# ------------------------------------------------------------------
# Inverter Configuration (Required)
# ------------------------------------------------------------------
#
# Before running controller.py, execute:
#
#     python test_read.py
#
# This utility will list all stations associated with your account
# together with their connected devices.
#
# If your account has multiple stations:
#   1. Choose the station you want this controller to manage.
#   2. Copy its stationId into DEYE_STATION_ID.
#
# For the selected station:
#   1. Locate the device whose deviceType is "INVERTER".
#   2. Copy its deviceId into DEYE_DEVICE_SN.
#

DEYE_STATION_ID=your_station_id
DEYE_DEVICE_SN=your_inverter_device_id

# ------------------------------------------------------------------
# Automation Settings
# ------------------------------------------------------------------

# Grid voltage (Volts) below which the grid is considered offline.
GRID_DOWN_VOLTAGE_THRESHOLD=100

# Maximum battery charge current (Amps)
#
# WARNING -- these are NOT universal defaults. The values below (100 / 150)
# are specific to my own setup: a 200Ah+ battery bank rated at 52V nominal.
# They are the median/example values used in this project's docs and
# screenshots -- nothing more.
#
# You MUST determine your own safe values from:
#   1. Your battery's (or BMS's) datasheet -- look for its rated max charge
#      current or charge C-rate (e.g. 0.5C on a 200Ah battery = 100A).
#   2. Your inverter's own maximum charge current spec (a hard ceiling
#      regardless of what your battery could theoretically take).
#
# Setting this too high for your actual hardware can damage your battery,
# void warranties, or create a safety hazard. If you are not confident you
# understand your battery and inverter's real limits, do not guess --
# consult your installer, your battery/BMS documentation, or Deye support
# before changing these from safe, conservative values.
#
# NORMAL_MAX_CHARGE_CURRENT:
#   Used while the grid is available.
#
# OUTAGE_MAX_CHARGE_CURRENT:
#   Applied during a confirmed grid outage to maximize solar harvesting.
NORMAL_MAX_CHARGE_CURRENT=100
OUTAGE_MAX_CHARGE_CURRENT=150

# Poll interval (seconds).
# Keep this conservative since all requests go through the Deye Cloud API.
POLL_INTERVAL_SECONDS=30

# Number of consecutive polls required before confirming a grid
# state change. Helps prevent false triggers caused by brief outages
# or delayed cloud updates.
DEBOUNCE_POLLS=3

# ------------------------------------------------------------------
# Active Monitoring Window
# ------------------------------------------------------------------
#
# The controller only monitors and performs automation during this
# daily time window (24-hour HH:MM, based on the system's local time).
#
# Outside this window the application sleeps without polling the API,
# reducing unnecessary cloud requests overnight.

ACTIVE_START_TIME=06:00
ACTIVE_END_TIME=17:00

# Sleep interval (seconds) while outside the active monitoring window.
OUTSIDE_WINDOW_SLEEP_SECONDS=600